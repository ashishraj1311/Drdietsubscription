# Dr Diet — environment variables
#
# Copy to `.env.local` and fill in to switch the app from the localStorage mock
# to a real Supabase backend. With these UNSET, the app runs on the mock exactly
# as before (no backend needed). See docs/06-SUPABASE-SETUP.md.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
